#include <windows.h>
#include "resource.h"

// Application Icon
IDI_APP_ICON ICON "MouseRipple.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "MouseRipple"
            VALUE "FileDescription",  "MouseRipple - 鼠标水波纹与流光拖尾"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MouseRipple"
            VALUE "LegalCopyright",   "Open Source (MIT License)"
            VALUE "OriginalFilename", "MouseRipple.exe"
            VALUE "ProductName",      "MouseRipple"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
